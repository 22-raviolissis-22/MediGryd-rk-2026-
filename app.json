{
  "expo": {
    "name": "MediGryd",
    "slug": "medigryd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C4A3E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.calrx.assist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MediGryd uses your location only to sort nearby pharmacies. Location stays on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C4A3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "org.calrx.assist",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "MediGryd"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MediGryd uses your location only to sort nearby pharmacies. Location stays on this device."
        }
      ]
    ]
  }
}
